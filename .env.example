# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Required for API, workers, and Prisma migrations.
# For Docker Compose, the hostname is "postgres"; for local host runs, use "localhost".
DATABASE_URL=postgresql://surpluss:surpluss_secret@localhost:5432/surpluss

# ─── NestJS API ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# ─── Retry & Exponential Backoff ─────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=5
RETRY_INITIAL_DELAY_MS=2000
RETRY_MAX_DELAY_MS=60000
RETRY_BACKOFF_MULTIPLIER=2

# ─── Background Worker ───────────────────────────────────────────────────────
# WORKER_ID should be unique per worker process (defaults to worker-<uuid> if omitted)
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_DURATION_MS=30000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_RECOVERY_INTERVAL_MS=15000

# ─── Next.js Dashboard ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
